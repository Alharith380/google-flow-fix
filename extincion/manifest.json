{
  "manifest_version": 3,
  "name": "Google Flow Fix",
  "description": "Skips Google Flow's unsupported-country, unavailable and unsupported-browser redirects. By Al-Harith Miyasa.",
  "version": "1.2.0",
  "author": "Al-Harith Miyasa",
  "icons": {
    "16": "icon/16.png",
    "32": "icon/32.png",
    "48": "icon/48.png",
    "96": "icon/96.png",
    "128": "icon/128.png"
  },
  "content_scripts": [
    {
      "matches": ["https://flow.google.com/*"],
      "run_at": "document_start",
      "js": ["content-scripts/content.js"],
      "world": "MAIN"
    }
  ]
}